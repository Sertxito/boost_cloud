{
  "name": "boost-cloud",
  "version": "0.1.0",
  "description": "Cloud Boost for Azure and AWS: agents, skills, prompts, specs and evals for enterprise cloud architecture and operations.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./boost.json": "./boost.json"
  },
  "files": [
    "boost.json",
    "agents",
    "instructions",
    "specs",
    "skills",
    "prompts",
    "evals",
    "examples",
    "scripts",
    "README.md",
    "LICENSE",
    ".github/copilot-instructions.md"
  ],
  "scripts": {
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:docs:update": "node scripts/check-doc-links.mjs --update",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run validate:manifest && npm run pack:check",
    "quality": "npm run validate",
    "release": "npm publish --access public",
    "boost:install": "node scripts/install.mjs",
    "boost:check": "node scripts/install.mjs --check"
  },
  "keywords": [
    "cloud",
    "azure",
    "aws",
    "iac",
    "devops",
    "well-architected",
    "agents",
    "skills",
    "copilot",
    "github-copilot",
    "agent-skills"
  ],
  "author": "Sertxito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sertxito/boost_cloud.git"
  },
  "bugs": {
    "url": "https://github.com/Sertxito/boost_cloud/issues"
  },
  "homepage": "https://github.com/Sertxito/boost_cloud#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "bin": {
    "boost-cloud": "scripts/install.mjs"
  }
}
